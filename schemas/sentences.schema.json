{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentences.schema.json",
  "title": "SentenceChunk",
  "description": "Generated by tools/sentences.py from Tatoeba (CC BY 2.0 FR). Each word token lists every reading consistent with its spelling and stress as 'lexId|slot' (slot '' for uninflected words; pseudo-slots like 'gen' or 'f_acc' for closed-class words; lexId 'name:…' for names).",
  "type": "array",
  "items": {
    "title": "Sentence",
    "type": "object",
    "required": ["id", "ru", "en", "lv", "r", "w"],
    "additionalProperties": false,
    "properties": {
      "id": {"type": "string", "pattern": "^s:[0-9]+$"},
      "ru": {"type": "string", "minLength": 2},
      "en": {"type": "array", "items": {"type": "string"}, "minItems": 1},
      "lv": {"$ref": "common.schema.json#/$defs/level"},
      "r": {"type": "integer", "minimum": 0},
      "w": {
        "type": "array",
        "minItems": 2,
        "items": {"type": "array", "minItems": 3, "prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": {"type": ["string", "integer"]}}
      }
    }
  }
}
