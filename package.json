{
  "name": "medved",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "«Медведь»: an offline Russian course from A2 to C1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen:types": "node scripts/gen-types.mjs",
    "data:fetch": "bash tools/fetch_sources.sh",
    "data:ingest": "python3 tools/ingest.py",
    "data:validate": "python3 tools/validate.py",
    "data:test": "python3 -m unittest discover -s tools/tests",
    "check": "npm run data:test && npm run data:validate && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
