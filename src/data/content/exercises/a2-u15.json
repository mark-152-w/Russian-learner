 "items": [
  {
   "id": "ex-a2-u15-01",
   "type": "choice",
   "level": "A2",
   "tags": [
    "pron.possessive"
   ],
   "prompt": {
    "ru": "Э́то ___ сестра́.",
    "en": "This is my sister.",
    "instruction": "Choose the right word"
   },
   "accept": [
    "моя́"
   ],
   "distractors": [
    {
     "ru": "мой",
     "error": "agreement.gender",
     "why": "**сестра́** is feminine: **моя́**."
    }
   ],
   "source": "handwritten"
  },
  {
   "id": "ex-a2-u15-02",
   "type": "choice",
   "level": "A2",
   "tags": [
    "pron.possessive"
   ],
   "prompt": {
    "ru": "Он лю́бит ___ жену́.",
    "en": "He loves his (own) wife.",
    "instruction": "Choose the right word"
   },
   "accept": [
    "свою́"
   ],
   "distractors": [
    {
     "ru": "его́",
     "error": "pronoun.svoy",
     "why": "His own wife, with **он** as subject: **свою́**. **его́** would be another man's wife."
    }
   ],
   "source": "handwritten"
  },
  {
   "id": "ex-a2-u15-03",
   "type": "choice",
   "level": "A2",
   "tags": [
    "pron.possessive"
   ],
   "prompt": {
    "ru": "___ брат живёт в Москве́.",
    "en": "Her brother lives in Moscow.",
    "instruction": "Choose the right word"
   },
   "accept": [
    "Её"
   ],
   "distractors": [
    {
     "ru": "Свой",
     "error": "pronoun.svoy",
     "why": "**свой** can't be part of the subject."
    }
   ],
   "source": "handwritten"
  },
  {
   "id": "ex-a2-u15-04",
   "type": "choice",
   "level": "A2",
   "tags": [
    "pron.personal"
   ],
   "prompt": {
    "ru": "Я говорю́ с ___.",
