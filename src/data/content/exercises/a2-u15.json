   "distractors": [
    {
     "ru": "им",
     "error": "pronoun.form",
     "why": "After a preposition: the **н-** form."
    },
    {
     "ru": "его́",
     "error": "pronoun.form",
     "why": "**с** takes the instrumental: **ним**."
    }
   ],
   "source": "handwritten"
  },
