   "type": "choice",
   "level": "A2",
   "tags": [
    "case.prep.location",
    "case.motion-location"
   ],
   "prompt": {
    "ru": "Мы живём ___.",
    "en": "We live in Moscow.",
    "instruction": "Choose the right phrase"
   },
   "accept": [
    "в Москве́"
   ],
   "distractors": [
    {
     "ru": "в Москву́",
     "error": "case.acc-for-prep",
     "why": "Living is location (где?): **в** + prepositional."
    },
    {
     "ru": "из Москвы́",
     "error": "motion.where-whither",
     "why": "**из** means *from*."
    }
   ],
   "source": "handwritten"
  },
  {
