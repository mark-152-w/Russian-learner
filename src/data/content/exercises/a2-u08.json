   "accept": [
    "У меня́"
   ],
   "distractors": [
    {
     "ru": "Я",
     "error": "case.nom-default",
     "why": "*Having* is **у** + genitive: **у меня́ есть**."
    },
    {
     "ru": "Мне",
     "error": "case.wrong",
     "why": "**мне** is dative; having uses **у меня́**."
    }
   ],
   "source": "handwritten"
  },
